// Este é o seu arquivo de configuração do Prisma corrigido

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  cpf       String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Calcado {
  id                    Int    @id @default(autoincrement())
  nome_produto          String
  cor                   String
  marca                 String
  tamanho               Int
  preco                 Int
  quantidade_em_estoque Int
}